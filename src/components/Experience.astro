---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Noviembre 2024 - Actualidad",
    title: "Titanic Soft",
    description:
      "Análisis de requerimientos a medida, diseño de arquitectura y desarrollo de soluciones de software robustas, flexibles y alineadas con las necesidades del negocio.",
  },
  {
    date: "Febrero - Julio 2024",
    title: "SofticsLab",
    description:
      "Desarrollo de nuevos requerimientos para proyectos en producción de la empresa. Trabajando con tecnologías como LARAVEL, VUE 3 y GitHub para control de versiones.",
  },
  {
    date: "Agosto - Diciembre 2023",
    title: "Colegio Uniciencia",
    description:
      "Creación de un sistema de control de asistencias por medio de un código QR con las tecnologías HTML, JavaScript, CSS y PHP. Así mismo la personalización del CMS Moodle para gestión de los recursos de la institución.",
  },
  {
    date: "Enero - Julio 2023",
    title: "APR Support",
    description:
      "Desarrollo de páginas web con las tecnologías HTML, CSS y JavaScript según los requerimientos de los clientes.",
  },
];
---

<ol class="relative z-10 border-s border-gray-200 ml-[10px]">
  {
    EXPERIENCE.map((experience) => (
      <li class="mb-10 ms-4">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
